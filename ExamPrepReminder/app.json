{
  "expo": {
    "name": "ExamPrepReminder",
    "slug": "exam-prep-reminder",
    "version": "1.0.0",
    "scheme": "examprep",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1020",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.examprep.reminder" },
    "android": {
      "package": "com.examprep.reminder",
      "permissions": ["POST_NOTIFICATIONS", "SCHEDULE_EXACT_ALARM"]
    },
    "web": { "bundler": "metro" },
    "plugins": [
      "expo-router",
      ["expo-notifications", { "color": "#7C9CFF" }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
